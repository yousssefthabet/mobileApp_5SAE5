rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // A worker is a user whose document has role == 'worker'.
    // Set that field by hand in the Firebase console.
    function isWorker() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) == 'worker';
    }

    // Users may not give themselves (or remove) a role.
    function roleUnchanged() {
      return request.resource.data.get('role', null) == resource.data.get('role', null);
    }

    // User profile document and subcollections
    match /users/{userId} {
      allow read: if isOwner(userId) || isWorker();
      allow create: if isOwner(userId) && request.resource.data.get('role', null) == null;
      allow update: if isOwner(userId) && roleUnchanged();
      allow delete: if isOwner(userId);

      // Reports: the author has full CRUD; workers can read, update and delete.
      match /reports/{reportId} {
        allow read, write: if isOwner(userId);
        allow read, update, delete: if isWorker();
      }

      // Notifications about the user's reports, written by workers.
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isWorker();
      }

      // Private reservations subcollection
      match /reservations/{reservationId} {
        allow read, write: if isOwner(userId);
      }

      // Private reward history subcollection
      match /reward_history/{historyId} {
        allow read, write: if isOwner(userId);
      }

      // Private promo codes subcollection
      match /promo_codes/{codeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // EV Chargers: public read for map; update allowed for connector status
    match /ev_chargers/{chargerId} {
      allow read: if true;
      allow write: if true;
    }

    // Kiosks: public read for map
    match /kiosk/{kioskId} {
      allow read: if true;
      allow write: if true;
    }

    // Top-level reservations collection
    match /reservations/{reservationId} {
      allow read: if true;
      allow write: if true;
    }

    // Top-level reports collection
    match /reports/{reportId} {
      allow read: if true;
      allow write: if true;
    }

    // Workers list every user's reports with a collection-group query.
    match /{path=**}/reports/{reportId} {
      allow read: if isWorker();
    }

    // Default deny for any unmatched document or collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
